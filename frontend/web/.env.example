# 留空 = 与页面同源（经网关访问 /api/v1），生产构建推荐保持为空。
# 本地 vite dev 用代理把 /api 与 /ws 转发到后端，见 vite.config.ts。
VITE_API_URL=

# 可选：仅开发期覆盖后端直连地址。
# 默认 8001 = docker-compose.yml 的 API 直连端口；跑 docker-compose.dev.yml 时用 8002。
VITE_DEV_API_ORIGIN=http://127.0.0.1:8001

# 可选：协作编辑网关（/ws/collab）的转发目标，默认指向 dev nginx。
VITE_DEV_COLLAB_ORIGIN=http://127.0.0.1:8080
